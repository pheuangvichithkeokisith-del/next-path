# PATHAI Backend Configuration

PROJECT_NAME="PATHAI Backend Service"
ENVIRONMENT="development"
DEBUG=True

# Database connection:
# For SQLite (local development):
DATABASE_URL="sqlite+aiosqlite:///./pathai.db"

# For Supabase PostgreSQL (Production):
# Option A - Direct Connection (port 5432):
# DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# Option B - Supabase Pooler (port 6543 / 5432):
# DATABASE_URL="postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# CORS Allowed Origins (comma separated or JSON array)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Questionnaire form version
DEFAULT_FORM_VERSION="v0.9.1"
